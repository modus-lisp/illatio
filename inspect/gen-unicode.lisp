;;;; gen-unicode.lisp -- regenerate src/unicode-data.lisp (run from the repo root):
;;;;   sbcl --script inspect/gen-unicode.lisp
;; Generate src/unicode-data.lisp from SBCL's own tables: the code-point ranges
;; illatio's pre-tokenizer asks about (letters, numbers, whitespace).
(defun ranges (pred)
  (let ((out '()) (start nil))
    (dotimes (cp (1+ #x10FFFF))
      (let ((c (code-char cp)))
        (if (and c (funcall pred c))
            (unless start (setq start cp))
            (when start (push (list start (1- cp)) out) (setq start nil)))))
    (when start (push (list start #x10FFFF) out))
    (nreverse out)))
(defun cat-in (cats) (lambda (c) (member (sb-unicode:general-category c) cats)))
(let ((letters (ranges (cat-in '(:lu :ll :lt :lm :lo))))
      (numbers (ranges (cat-in '(:nd :nl :no))))
      (spaces (ranges #'sb-unicode:whitespace-p))
      (marks (ranges (cat-in '(:mn :mc :me)))))
  (with-open-file (o "src/unicode-data.lisp" :direction :output :if-exists :supersede)
    (format o ";;;; unicode-data.lisp -- generated by inspect/gen-unicode.lisp from SBCL ~A's~%" (lisp-implementation-version))
    (format o ";;;; Unicode tables; do not edit.  Code-point ranges, inclusive, ascending.~%~%(in-package #:illatio)~%")
    (flet ((emit (name doc rs)
             (format o "~%(defparameter ~A~%  (coerce '(~{~D~^ ~}) '(simple-array (unsigned-byte 32) (*)))~%  ~S)~%"
                     name (loop for (a b) in rs append (list a b)) doc)))
      (emit "+letter-ranges+" "General categories Lu Ll Lt Lm Lo." letters)
      (emit "+number-ranges+" "General categories Nd Nl No." numbers)
      (emit "+space-ranges+" "White_Space." spaces)
      (emit "+mark-ranges+" "General categories Mn Mc Me." marks))
    (format t "letters ~D ranges, numbers ~D, spaces ~D~%" (length letters) (length numbers) (length spaces))))
